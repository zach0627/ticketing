# 複製成同目錄的 azure.env 再填入實際值。
#   cp deploy/scripts/azure.env.example deploy/scripts/azure.env
#
# azure.env 被 .gitignore 的 *.env 排除，不會進版控——這是刻意的：
# 這個 repo 是公開的，而資料庫端點不該公布（理由見 db-access.sh 開頭的註解）。
#
# 這裡面**沒有機密**，只有資源名稱；驗證一律走 az login 的身分。
TICKETING_RG=YOUR_RESOURCE_GROUP
TICKETING_SQL_SERVER=YOUR_SQL_SERVER_NAME
# 選填，預設 dev-roaming
# TICKETING_DEV_RULE=dev-roaming
