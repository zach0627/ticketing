{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },

  "Hosting": {
    "//": "App Service 的『HTTPS Only』已經在平台的前端做完 HTTP→HTTPS 轉址。應用程式再做一次會無窮迴圈：平台把請求以 http 轉進來，我們又把它導去 https，平台再轉進來……（設計文件 16 第 8 節）",
    "HttpsRedirection": false
  }
}
